# Proveedor activo: openai | anthropic | gemini
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Gemini (también acepta GEMINI_API_KEY)
GOOGLE_API_KEY=AIza...
GEMINI_MODEL=gemini-flash-latest

# Timeout HTTP en segundos
LLM_TIMEOUT=30
